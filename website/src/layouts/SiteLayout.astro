---
import '../styles/utilities.css';
import siteCss from '../styles/site.css?raw';
interface Props { head: string; css: string }
const { head, css } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <Fragment set:html={head} />
  <style is:inline set:html={siteCss + css}></style>
</head>
<body><slot /></body>
</html>
